# Only ignores what is noise for this project.
# The shared templates live in harness/template/shared/.gitignore and are merged into this one.

# --- secrets: the rule is "there must be none", but the pattern stays ---
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- artifacts ---
/tmp/
/logs/
*.log
coverage/
node_modules/
vendor/
# binaries and artifacts
/target/
