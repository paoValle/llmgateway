# Copy this file, rename it `gateway.env` (it is in .gitignore) and fill in the values.
# The gateway does not look for them by itself: it calls them with the names declared
# in gateway.toml.

# Provider keys
PRIMARY_API_KEY=sk-...
SECONDARY_API_KEY=sk-...

# Tenant keys: a long, random string. Whoever knows it can spend that tenant's
# budget, so it must not be readable by any other process.
TENANT_ACME_KEY=generate-a-random-32-byte-string-here
TENANT_BETA_KEY=generate-another-random-string-here
