# Copia questo file, rinominalo `gateway.env` (nel .gitignore) e riempi i valori.
# Il gateway non le cerca da sole: le chiama con i nomi dichiarati in gateway.toml.

# Chiavi dei provider
PRIMARIO_API_KEY=sk-...
SECONDARIO_API_KEY=sk-...

# Chiavi dei tenant: una stringa lunga e casuale. Chi la conosce può spendere il
# budget di quel tenant, quindi non deve essere leggibile da nessun altro processo.
TENANT_ACME_KEY=genera-qui-una-stringa-casuale-di-32-byte
TENANT_BETA_KEY=genera-qui-un-altra-stringa-casuale
